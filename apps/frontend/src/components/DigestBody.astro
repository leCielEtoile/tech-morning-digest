---
import type { CollectionEntry } from "astro:content";
import { formatJstDateLabel } from "../lib/format-date.js";

interface Props {
  entry: CollectionEntry<"digests">;
}

const { entry } = Astro.props;
const { data } = entry;
const dateLabel = formatJstDateLabel(data.date);
---

<article>
	<h1 class="digest-date" aria-label={`${dateLabel}のテックダイジェスト`}><time datetime={data.date}>{dateLabel}</time></h1>
	{
		data.hasNewArticles ? (
			<div class="digest-content">
				<h2 class="eyebrow">今日の3行</h2>
				<ol class="three-lines">
					{data.threeLines.map((line) => (
						<li>{line}</li>
					))}
				</ol>

				{data.categories.length > 0 && (
					<nav class="category-tabs" aria-label="カテゴリ" data-category-tabs>
						{data.categories.map((category, i) => (
							<a href={`#category-${i}`} class="category-tabs__item" data-category-tab>
								{category.category}
							</a>
						))}
					</nav>
				)}

				{data.categories.map((category, i) => (
					<section id={`category-${i}`} class="category-section" data-category-section>
						<h2 class="eyebrow">{category.category}</h2>

						{category.picks.length > 0 && (
							<ol class="picks-list">
								{category.picks.map((pick) => (
									<li>
										<a href={pick.link}>{pick.title}</a>
										<p class="pick-reason">{pick.reason}</p>
										<p class="pick-summary">{pick.summary}</p>
										<span class="pick-feed">{pick.feedName}</span>
										<button type="button" class="bookmark-button" data-bookmark-link={pick.link} data-bookmark-title={pick.title}>
											☆ ブックマーク
										</button>
									</li>
								))}
							</ol>
						)}

						{category.others.length > 0 && (
							<ul class="category-list">
								{category.others.map((article) => (
									<li>
										<div class="article-heading">
											<a href={article.link}>{article.title}</a>
											<span class="article-feed">{article.feedName}</span>
										</div>
										<p class="article-gist">{article.gist}</p>
										<button type="button" class="bookmark-button" data-bookmark-link={article.link} data-bookmark-title={article.title}>
											☆ ブックマーク
										</button>
									</li>
								))}
							</ul>
						)}
					</section>
				))}
			</div>
		) : (
			<p class="no-articles">本日は配信なし。対象フィードに新着がありませんでした。また明朝。</p>
		)
	}
</article>

<script>
	// カテゴリタブ: JS無効環境でも全カテゴリが縦に並ぶページ内リンクとして機能する(プログレッシブエンハンスメント)。
	// role="tab"等のARIA属性もJS実行時のみ付与する。JSが動かない場合に「タブ widgetのはずなのに
	// 矢印キー操作ができない」という不完全なARIA実装にしないため(WAI-ARIA Authoring Practices準拠)。
	function initCategoryTabs(): void {
		const tablist = document.querySelector<HTMLElement>("[data-category-tabs]");
		const tabs = document.querySelectorAll<HTMLAnchorElement>("[data-category-tab]");
		const sections = document.querySelectorAll<HTMLElement>("[data-category-section]");
		if (!tablist || tabs.length === 0 || sections.length === 0) return;

		const tabList = Array.from(tabs);
		const sectionList = Array.from(sections);

		tablist.setAttribute("role", "tablist");
		tabList.forEach((tab, i) => {
			tab.setAttribute("role", "tab");
			tab.id = `category-tab-${i}`;
			tab.setAttribute("aria-controls", sectionList[i]?.id ?? "");
		});
		sectionList.forEach((section, i) => {
			section.setAttribute("role", "tabpanel");
			section.setAttribute("aria-labelledby", tabList[i]?.id ?? "");
		});

		function activate(index: number): void {
			tabList.forEach((tab, i) => {
				const active = i === index;
				tab.classList.toggle("is-active", active);
				tab.setAttribute("aria-selected", String(active));
				tab.tabIndex = active ? 0 : -1;
			});
			sectionList.forEach((section, i) => {
				section.hidden = i !== index;
			});
		}

		tabList.forEach((tab, i) => {
			tab.addEventListener("click", (event) => {
				event.preventDefault();
				activate(i);
			});

			// 矢印キー・Home/Endでのタブ間移動(WAI-ARIA Authoring Practicesのタブパターン、automatic activation)
			tab.addEventListener("keydown", (event) => {
				let nextIndex: number | null = null;
				if (event.key === "ArrowRight") nextIndex = (i + 1) % tabList.length;
				else if (event.key === "ArrowLeft") nextIndex = (i - 1 + tabList.length) % tabList.length;
				else if (event.key === "Home") nextIndex = 0;
				else if (event.key === "End") nextIndex = tabList.length - 1;
				if (nextIndex !== null) {
					event.preventDefault();
					tabList[nextIndex]?.focus();
					activate(nextIndex);
				}
			});
		});

		// モバイルでの左右スワイプでもタブ切り替えできるようにする。表示中パネルのみが
		// タッチを受け取れるため、パネルごとの現在indexはsectionList.indexOfで特定できる。
		const SWIPE_THRESHOLD_PX = 50;
		let touchStartX = 0;
		let touchStartY = 0;
		sectionList.forEach((section) => {
			section.addEventListener(
				"touchstart",
				(event) => {
					const touch = event.touches[0];
					if (!touch) return;
					touchStartX = touch.clientX;
					touchStartY = touch.clientY;
				},
				{ passive: true },
			);

			section.addEventListener(
				"touchend",
				(event) => {
					const touch = event.changedTouches[0];
					if (!touch) return;
					const deltaX = touch.clientX - touchStartX;
					const deltaY = touch.clientY - touchStartY;
					if (Math.abs(deltaX) < SWIPE_THRESHOLD_PX || Math.abs(deltaX) < Math.abs(deltaY)) return;
					const currentIndex = sectionList.indexOf(section);
					if (currentIndex === -1) return;
					const nextIndex =
						deltaX < 0 ? (currentIndex + 1) % tabList.length : (currentIndex - 1 + tabList.length) % tabList.length;
					activate(nextIndex);
				},
				{ passive: true },
			);
		});

		// location.hashが既存カテゴリを指していればそれを初期表示にする(共有リンクでのディープリンク対応)
		const requestedId = location.hash.slice(1);
		const requestedIndex = sectionList.findIndex((section) => section.id === requestedId);
		activate(requestedIndex !== -1 ? requestedIndex : 0);
	}

	/**
	 * 未ログイン(401)ならログインへ誘導する。ボタンのラベルを差し替えるだけの
	 * 簡易フィードバックとし、専用のトースト等は作らない(YAGNI)。
	 */
	function initBookmarkButtons(): void {
		const buttons = document.querySelectorAll<HTMLButtonElement>("[data-bookmark-link]");
		buttons.forEach((button) => {
			button.addEventListener("click", async () => {
				const articleLink = button.dataset.bookmarkLink;
				const articleTitle = button.dataset.bookmarkTitle;
				if (!articleLink || !articleTitle) return;

				button.disabled = true;
				const response = await fetch("/api/bookmarks", {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ articleLink, articleTitle }),
				});

				if (response.status === 401) {
					location.href = "/api/auth/login";
					return;
				}
				if (response.status === 409) {
					button.textContent = "上限到達";
					return;
				}
				if (!response.ok) {
					button.textContent = "失敗";
					button.disabled = false;
					return;
				}
				button.textContent = "保存済み";
			});
		});
	}

	initCategoryTabs();
	initBookmarkButtons();
</script>

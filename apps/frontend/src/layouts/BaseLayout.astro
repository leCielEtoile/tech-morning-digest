---
import "../styles/global.css";

interface Props {
  title: string;
  /** マストヘッド右側に表示する日付(例: "2026年8月5日")。省略時は日付を表示しない */
  dateline?: string;
}

const { title, dateline } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="毎朝、国内外17のテック系フィードからAIが選び抜いた今日のダイジェスト。" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<div class="page">
			<header class="masthead">
				<a class="masthead__wordmark" href="/">TECH MORNING DIGEST</a>
				<div class="masthead__meta">
					{dateline && <span>TOKYO — {dateline}</span>}
					<span class="masthead__auth" data-auth-status hidden>
						<a href="/api/auth/login" data-auth-login>ログイン</a>
						<button type="button" data-auth-logout hidden>ログアウト</button>
					</span>
					<nav aria-label="サイト内ナビゲーション"><a href="/archive/">アーカイブ →</a></nav>
				</div>
			</header>
			<main>
				<slot />
			</main>
		</div>
		<script>
			// ログイン状態はCookieの有無をJSからは判定できない(HttpOnly)ため、認証必須APIを
			// 1回叩いて401かどうかで判定する。JS無効環境では常に「ログイン」リンクが見える
			// (実際にクリックすればログインフローは動く)フォールバックになる。
			async function initAuthStatus(): Promise<void> {
				const statusEl = document.querySelector<HTMLElement>("[data-auth-status]");
				const loginLink = document.querySelector<HTMLAnchorElement>("[data-auth-login]");
				const logoutButton = document.querySelector<HTMLButtonElement>("[data-auth-logout]");
				if (!statusEl || !loginLink || !logoutButton) return;

				statusEl.hidden = false;

				const response = await fetch("/api/preferences", { method: "GET" });
				const isLoggedIn = response.status !== 401;
				loginLink.hidden = isLoggedIn;
				logoutButton.hidden = !isLoggedIn;

				logoutButton.addEventListener("click", async () => {
					await fetch("/api/auth/logout", { method: "POST" });
					location.reload();
				});
			}

			initAuthStatus();
		</script>
	</body>
</html>

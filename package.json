{
  "name": "rss-summary",
  "version": "0.1.0",
  "private": true,
  "description": "Tech Morning Digest monorepo — RSSフィードをAI要約したサマリページを配信するシステム",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "backend:start": "pnpm --filter @rss-summary/backend start",
    "backend:test": "pnpm --filter @rss-summary/backend test",
    "backend:typecheck": "pnpm --filter @rss-summary/backend typecheck",
    "frontend:dev": "pnpm --filter @rss-summary/frontend dev",
    "frontend:build": "pnpm --filter @rss-summary/frontend build"
  }
}

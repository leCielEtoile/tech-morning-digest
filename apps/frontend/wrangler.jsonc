{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-morning-digest",
  // ビルド日ごとに更新する(spec.md参照)
  "compatibility_date": "2026-09-11",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // 非機微な値のみ宣言する。secrets(DEPLOY_HOOK_URL/ALERT_WEBHOOK_URL/R2_ACCESS_KEY_ID/
  // R2_SECRET_ACCESS_KEY)はここに書かず、Cloudflareダッシュボード側のWorker secretsとして
  // 個別管理する(wrangler.jsonc未宣言のままだと、デプロイのたびに消える実害が過去にあったため、
  // 非機微な値だけでもここで宣言してデプロイのたびに確実に反映されるようにしている)。
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "9bbe04fcd60cb5aeefafef802bbdc1c5",
    "R2_BUCKET_NAME": "tech-morning-digest"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-morning-digest-users",
      "database_id": "8784933a-3fa5-457f-ad81-d50fd92c29a1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // UTC。23:30 = JST 08:30(前日) にビルド起動、02:00 に当日分の生成結果を確認
    "crons": ["30 23 * * *", "0 2 * * *"]
  }
}

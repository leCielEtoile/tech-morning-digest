{
  "name": "@rss-summary/frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test": "tsx --test 'worker/**/*.test.ts' 'src/**/*.test.ts'",
    "test:e2e": "vitest run",
    "test:e2e:prod": "tsx --test 'e2e-prod/**/*.test.ts'",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@hono/swagger-ui": "0.6.1",
    "@rss-summary/shared": "workspace:*",
    "astro": "7.3.2",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.8",
    "hono-openapi": "1.3.3",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@cloudflare/workers-types": "5.20260921.1",
    "@types/node": "26.5.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}